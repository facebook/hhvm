Applied edit for code action:
------------------------------------------
<?hh
//
<<file: __EnableUnstableFeatures('named_parameters')>>

class InlineNamedArgsReadOrder {


  private function bump(inout int $x): int {
    $x = $x + 1;
    return $x;
  }

  public function caller(): int {
    $x = 1;
    $a = $this->bump(inout $x);
    $b = $x;
    $res = $b;
    return $res;
  }
}
//

