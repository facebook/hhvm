<?hh
<<file: __EnableUnstableFeatures('case_types', 'like_type_hints')>>
function consume((TYPE#0, optional TYPE#1) $x): TYPE#0 { return $x[0]; }
function short(TYPE#0 $value): (TYPE#0, optional TYPE#1) { return tuple($value); }
function full(TYPE#0 $first, TYPE#1 $second): (TYPE#0, optional TYPE#1) { return tuple($first, $second); }
function optional_payload<T>((mixed, optional T) $x): shape('present' => bool, 'value' => ?T) {
  return shape('present' => count($x) === 2, 'value' => $x[1] ?? null);
}
<<__EntryPoint>>
function main(): void {
  $first = expr#0;
  $second = expr#1;
  assert_same(consume(short($first)), $first);
  assert_same(consume(full($first, $second)), $first);
  invariant(optional_payload<TYPE#1>(short($first)) === shape('present' => false, 'value' => null), 'absent optional payload');
  invariant(optional_payload<TYPE#1>(full($first, $second)) === shape('present' => true, 'value' => $second), 'present optional payload');
}

function assert_same(mixed $first, mixed $second): void { invariant($first === $second, 'identity'); }
