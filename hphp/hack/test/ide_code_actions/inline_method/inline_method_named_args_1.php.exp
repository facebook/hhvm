<?hh
//
<<file: __EnableUnstableFeatures('named_parameters')>>

class InlineNamedArgs {

  public function caller(): string {
    $param_a = "hello";
    $param_b = 2;
    $z = $param_a;
    if ($param_b > 1) {
      $z = $param_a.$param_b;
    }
    $res = $z;
    return $res;
  }
}
