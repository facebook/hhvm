<?hh
//
<<file: __EnableUnstableFeatures('named_parameters')>>

class InlineNamedVariadic {


  private function observe(string $x): string {
    return $x;
  }

  public function caller(): string {
    $__inline_method_named_arg_0 = $this->observe('first');
    $label = $this->observe('label');
    $__inline_method_named_arg_3 = $this->observe('last');
    $first = 2;
    $res = $label.$first;
    $__inline_method_named_arg_3 = null;
    $__inline_method_named_arg_0 = null;
    return $res;
  }
}
