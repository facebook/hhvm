<?hh
<<file: __EnableUnstableFeatures('case_types', 'like_type_hints')>>

<<__EntryPoint>> function main(): void {
  $payload = expr#1;
  $pointer = (identity_widen_pointer#1)(identity_child_pointer#1);
  $child = (identity_construct#1)($pointer, $payload);
  invariant((identity_is_child#1)($child), 'dynamic child construction');
  invariant(vec[(identity_read#1)($child)] === vec[$payload], 'dynamic child payload');
  $base = (identity_construct#1)(identity_base_pointer#1, $payload);
  invariant(!(identity_is_child#1)($base), 'dynamic base construction');
  invariant(vec[(identity_read#1)($base)] === vec[$payload], 'dynamic base payload');
}
