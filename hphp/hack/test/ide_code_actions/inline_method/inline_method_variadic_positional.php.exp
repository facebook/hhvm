<?hh
//
<<file: __EnableUnstableFeatures('named_parameters')>>

class InlineVariadicPositional {


  private function observe(int $x): int {
    return $x;
  }

  public function caller(): int {
    $head = $this->observe(1);
    $scale = $this->observe(2);
    $__inline_method_arg_2 = $this->observe(3);
    $__inline_method_arg_3 = $this->observe(4);
    $rest = vec[$__inline_method_arg_2, $__inline_method_arg_3];
    $__inline_method_arg_3 = null;
    $__inline_method_arg_2 = null;
    $res = $head + $rest[0] * $scale;
    $rest = null;
    return $res;
  }
}
//

