<?hh
<<file: __EnableUnstableFeatures('case_types', 'like_type_hints')>>

<<__EntryPoint>> function main(): void {
  $value = expr#1;
  $object = new DEPENDENT_CLASS#1($value);
  $exact = DEPENDENT_READ#1<TYPE#1>($object);
  $upper = DEPENDENT_READ_BOUND#1($object);
  invariant(vec[$exact, $upper] === vec[$value, $value], 'exact and upper-bound refinement reads');
}
