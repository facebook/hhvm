+  prefix="$(find_getdeps_prefix mcrouter || true)"
+  [ -n "$prefix" ] || return 1
+
+  for libdir in "$prefix/lib" "$prefix/lib64"; do
+    if [ -f "$prefix/include/mcrouter/McrouterClient.h" ] && \
+       [ -f "$libdir/cmake/mcrouter/mcrouter-config.cmake" ]; then
